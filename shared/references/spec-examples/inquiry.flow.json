{
 "type": "flowchart",
 "title": "Inquiry: flowchart",
 "nodes": [
  {
   "id": "s",
   "kind": "start",
   "spine": true,
   "label": "POST /inquiry\nInquiryRequest JSON · header api_key"
  },
  {
   "id": "n1",
   "kind": "step",
   "spine": true,
   "label": "Logger middleware\nStartTransaction(rrn, \"inquiry\")"
  },
  {
   "id": "n1-note",
   "kind": "note",
   "note_for": "n1",
   "label": "Logs the request as step 1 (IN) before any check."
  },
  {
   "id": "d2",
   "kind": "decision",
   "spine": true,
   "label": "api_key valid?"
  },
  {
   "id": "k2",
   "kind": "note",
   "note_for": "d2",
   "label": "Server.auth: header api_key must equal SERVER.API_KEY. An empty SERVER.API_KEY accepts a request with no header."
  },
  {
   "id": "e401",
   "kind": "err",
   "label": "401 {message: invalid api key}\nno transaction-log / ledger row written"
  },
  {
   "id": "d3",
   "kind": "decision",
   "spine": true,
   "label": "Content-Type JSON?"
  },
  {
   "id": "k3",
   "kind": "note",
   "note_for": "d3",
   "label": "Bind().WithAutoHandling().Body(): a missing or non-JSON Content-Type is rejected before parsing."
  },
  {
   "id": "e422",
   "kind": "err",
   "label": "422 Unprocessable Entity\n(text/plain)"
  },
  {
   "id": "d3b",
   "kind": "decision",
   "spine": true,
   "label": "body parses?"
  },
  {
   "id": "k3b",
   "kind": "note",
   "note_for": "d3b",
   "label": "Malformed JSON or a field of the wrong type fails the bind into InquiryRequest."
  },
  {
   "id": "e400",
   "kind": "err",
   "label": "400 \"Bad request: ...\"\n(text/plain)"
  },
  {
   "id": "n4",
   "kind": "step",
   "spine": true,
   "label": "Service.Inquiry\ntransid = TXN_ID_PREFIX + rrn"
  },
  {
   "id": "n4-note",
   "kind": "note",
   "note_for": "n4",
   "label": "customerId = normalised billData.customerId. A deferred call runs the transaction-log + ledger writers on every return."
  },
  {
   "id": "n6",
   "kind": "step",
   "spine": true,
   "label": "partner.Client.Inquiry\nPOST PARTNER_INQUIRY_URL"
  },
  {
   "id": "n6-note",
   "kind": "note",
   "note_for": "n6",
   "label": "Body {transid, customerId, channel}, header api_key, timeout CLIENT.PARTNER.TIMEOUT."
  },
  {
   "id": "tx",
   "kind": "external",
   "label": "Partner billing API"
  },
  {
   "id": "d6a",
   "kind": "decision",
   "spine": true,
   "label": "dial or DNS error?"
  },
  {
   "id": "k6a",
   "kind": "note",
   "note_for": "d6a",
   "label": "ErrUnreachable: the request never reached Partner API (net.OpError op=dial or net.DNSError)."
  },
  {
   "id": "x89",
   "kind": "step",
   "label": "respCode = 89 (link down)"
  },
  {
   "id": "d6b",
   "kind": "decision",
   "spine": true,
   "label": "no usable reply?"
  },
  {
   "id": "k6b",
   "kind": "note",
   "note_for": "d6b",
   "label": "ErrNoResponse: any other transport error or timeout, body read error, non-2xx status (4xx too) or non-JSON body."
  },
  {
   "id": "x68a",
   "kind": "step",
   "label": "respCode = 68 (timeout)"
  },
  {
   "id": "d6c",
   "kind": "decision",
   "spine": true,
   "label": "other error?"
  },
  {
   "id": "k6c",
   "kind": "note",
   "note_for": "d6c",
   "label": "JSON marshal error or an unparsable URL while building the request (nothing is logged for it)."
  },
  {
   "id": "x05",
   "kind": "step",
   "label": "respCode = 05 (general error)"
  },
  {
   "id": "d7",
   "kind": "decision",
   "spine": true,
   "label": "status in RC map?"
  },
  {
   "id": "k7",
   "kind": "note",
   "note_for": "d7",
   "label": "rcStore.Lookup(status): in-memory map loaded from PARTNER_RC_MAP."
  },
  {
   "id": "x68b",
   "kind": "step",
   "label": "slog \"failed to look up rc\"\nrespCode = 68"
  },
  {
   "id": "d8",
   "kind": "decision",
   "spine": true,
   "label": "name or ref too long?"
  },
  {
   "id": "k8",
   "kind": "note",
   "note_for": "d8",
   "label": "NewBillData pads customerName to 30 and billReference to 11 bytes. A longer value makes strings.Repeat panic (negative count)."
  },
  {
   "id": "e500",
   "kind": "err",
   "label": "500 \"strings: negative Repeat count\""
  },
  {
   "id": "n8",
   "kind": "step",
   "spine": true,
   "label": "respCode = mapped RC\nbillData = NewBillData(...)"
  },
  {
   "id": "n8-note",
   "kind": "note",
   "note_for": "n8",
   "label": "additionalData = accountNo, dueDay, autoDebitStatus, refNo."
  },
  {
   "id": "sub",
   "kind": "subflow",
   "spine": true,
   "label": "▶ Write transaction log + ledger"
  },
  {
   "id": "ok",
   "kind": "ok",
   "spine": true,
   "label": "HTTP 200 {respCode, billData}"
  },
  {
   "id": "ok-note",
   "kind": "note",
   "note_for": "ok",
   "label": "HTTP 200 even when respCode is an error."
  }
 ],
